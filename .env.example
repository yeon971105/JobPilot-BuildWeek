# Required. Use a pooled connection string for Vercel/serverless runtime when your
# managed Postgres provider offers one.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/jobpilot?schema=public"

# Optional. Use a direct/unpooled connection string for Prisma migrations when
# your provider separates pooled runtime URLs from direct migration URLs.
DIRECT_URL=""

# Required in production. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"

# Recommended for production/custom domains. Auth.js also accepts NEXTAUTH_URL.
AUTH_URL="https://your-jobpilot-app.vercel.app"
NEXTAUTH_URL=""

# AI matching. Providers are server-side only and used by explicit scripts.
AI_PROVIDER="mock"
OPENAI_API_KEY=""
EMBEDDING_MODEL="text-embedding-3-small"
MATCH_EXPLANATION_MODEL="gpt-4.1-mini"

# Build Week public demo. Keep BUILD_WEEK_ALLOW_LIVE_GPT56 false locally until a
# server-side key and request budget are configured. The browser never receives this key.
BUILD_WEEK_DEMO_MODE="true"
BUILD_WEEK_ALLOW_LIVE_GPT56="false"
OPENAI_BUILD_WEEK_MODEL="gpt-5.6-terra"
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="gemma4:12b"

# Local open-source AI service for RTX 5080 matching.
LOCAL_AI_BASE_URL="http://localhost:8001"
LOCAL_EMBEDDING_MODEL="BAAI/bge-m3"
LOCAL_RERANKER_MODEL="BAAI/bge-reranker-v2-m3"
LOCAL_RERANKER_ENABLED="true"
LOCAL_AI_TIMEOUT_MS="30000"

# Protected scheduled ATS sync endpoint. Leave CRON_SECRET blank unless you
# intentionally call POST /api/cron/sync from a trusted scheduler.
CRON_SECRET=""
SCHEDULED_SYNC_MAX_SOURCES="5"
SCHEDULED_SYNC_DEFAULT_LIMIT="3"
SCHEDULED_SYNC_MIN_INTERVAL_MINUTES="30"
SCHEDULED_SYNC_ALLOWED_PROVIDERS="greenhouse,lever,ashby"

# Optional official external feed credentials for higher-yield nationwide sync.
CAREERONESTOP_API_TOKEN=""
CAREERONESTOP_USER_ID=""

# Verified catalog rollout. shadow retains the legacy compatibility search;
# internal_preview serves only current approved/apply-ready internal evidence
# outside production; enforced serves only public LIVE (or LIVE+RECENT).
VERIFIED_CATALOG_ROLLOUT="shadow"

# Optional OpenSearch backend. When blank, the queue uses PostgreSQL/materialized
# views as the early-stage search backend.
OPENSEARCH_URL=""
OPENSEARCH_LIVE_INDEX="live-jobs"
OPENSEARCH_RECENT_INDEX="recent-jobs"
OPENSEARCH_USERNAME=""
OPENSEARCH_PASSWORD=""
OPENSEARCH_BEARER_TOKEN=""
