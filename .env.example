# JobPilot Build Week — public-safe local-first defaults
# Copy to .env.local for local overrides. Never commit .env.local or a real key.

AI_RUNTIME_MODE="LOCAL_FIRST"

# Primary semantic runtime. The public judge build uses prepared analyses and does
# not require Ollama; local reanalysis remains opt-in and loopback-only.
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="gemma4:12b"
OLLAMA_ENABLED="true"

# Real resume intake is disabled in public judge deployments. Enable only on a
# trusted local JobPilot edition with loopback Ollama available.
LOCAL_PRIVATE_MODE="false"

# Optional bounded heavy reasoning. OPENAI_HEAVY_FEATURES_ENABLED is the single
# feature gate; the legacy Build Week flag is accepted as an equivalent alias.
OPENAI_HEAVY_FEATURES_ENABLED="false"
OPENAI_API_KEY=""
OPENAI_HEAVY_MODEL="gpt-5.6-terra"

# Reliable no-key judge mode.
BUILD_WEEK_DEMO_MODE="true"
BUILD_WEEK_USE_CACHED_GEMMA_ANALYSES="true"
BUILD_WEEK_ALLOW_LOCAL_GEMMA_REANALYSIS="false"
BUILD_WEEK_ALLOW_LIVE_GPT56="false"
